# ==============================================================================
# AI WhatsApp Sales & Support Platform - Production Environment Variables
# Hostinger Cloud Startup Configuration
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Meta WhatsApp Cloud API credentials
# (From Meta Developers Portal -> WhatsApp -> API Setup)
META_ACCESS_TOKEN=EAAG...your_permanent_system_user_access_token
META_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WABA_ID=your_meta_waba_account_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=passion_fruit_verify_token_2025
META_CATALOG_ID=your_meta_commerce_catalog_id
META_GRAPH_API_VERSION=v25.0

# AI Sales & Support Engine
# (Google Gemini API Key for instant AI FAQ & lead qualification)
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# Security & Data Encryption (AES-256-GCM)
# Generate a 32-byte hex key: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUTH_SESSION_SECRET=generate_a_unique_random_secret_of_at_least_32_characters

# Supabase / PostgreSQL Connection (Required for accounts and workspace settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Redis Queue Connection (BullMQ bulk broadcast pacing on Hostinger VPS)
# Example: redis://default:password@127.0.0.1:6379
# Redis is required for campaign dispatch; there is no in-memory production fallback.
REDIS_URL=redis://127.0.0.1:6379

# Shared by web and worker; use a random secret of at least 32 characters.
WORKER_SECRET=
# Optional: defaults to the local Next server /api/internal/workflow-delays
WORKFLOW_RUNNER_URL=

# AI actions require a provider-supported model; set it after verifying your account access.
GEMINI_MODEL=
# Exact HTTPS integration hostnames approved by an administrator, comma separated.
WORKFLOW_HTTP_ALLOWED_HOSTS=
