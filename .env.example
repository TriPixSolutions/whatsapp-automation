# Supabase Credentials (PostgreSQL & Authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_service_role_key

# Redis Queue Connection (Hosted on Hostinger Cloud Server or Upstash)
# Example Hostinger VPS: redis://default:your_redis_password@123.456.78.90:6379
# Example Local Dev: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Meta WhatsApp Cloud API Credentials
# Obtained from Meta Developer Portal -> WhatsApp -> API Setup
META_ACCESS_TOKEN=EAAG...your_permanent_system_user_access_token
META_PHONE_NUMBER_ID=109823485764321
META_WABA_ID=102938475610293
META_WEBHOOK_VERIFY_TOKEN=apex_luxury_secret_token_2025
META_GRAPH_API_VERSION=v18.0

# Application URL (Used for Webhook routing and OAuth redirects)
NEXT_PUBLIC_APP_URL=https://your-luxury-saas.vercel.app

# Default Workspace ID (Matches seed.sql test workspace)
DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
